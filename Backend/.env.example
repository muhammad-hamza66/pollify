# ── Pollify Backend Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/pollify?appName=Cluster0

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters required. The server will refuse to start without a strong secret.
JWT_SECRET=

# SMTP (email / OTP delivery)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# Frontend URL (used for CORS whitelist — comma-separate multiple origins)
CLIENT_URL=http://localhost:5173

# Runtime environment: development | production
NODE_ENV=development
